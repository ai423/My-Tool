# העתיקו את הקובץ הזה ל-.env.local לעבודה מקומית.
# ב-Vercel מגדירים את אותם משתנים תחת Settings > Environment Variables.
# סודות אף פעם לא נכנסים לקוד ולא לגיט.

# נדרש רק אם הכלי שלכם קורא ל-Claude בזמן ריצה (סיווג, סיכום, ניסוח).
# רוב הכלים הראשונים לא צריכים את זה: ה-AI היה בבנייה, לא בריצה.
ANTHROPIC_API_KEY=

# אופציונלי. ברירת המחדל נמצאת ב-lib/claude.ts
CLAUDE_MODEL=

# Supabase: בסיס הנתונים וההתחברות. הערכים בלוח הבקרה של הפרויקט, תחת Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# קריאת עמודים שחוסמים קריאה אוטומטית (Jina Reader). אופציונלי: בלי מפתח זה עובד במגבלות נמוכות.
JINA_API_KEY=

# חיפוש מקורות עם Tavily. אופציונלי: נדרש רק אם בוחרים "Tavily" במסך כתיבת המאמר.
TAVILY_API_KEY=
